{
    // --- Typography & Layout ---
    "font_face": "JetBrainsMono Nerd Font",

    // --- Minimalist UI Tweaks ---
    "minimap_scroll_to_clicked_on": true,
    "show_minimap": false,
    "overlay_scroll_bars": "when_moving",
    "line_numbers": true,
    "gutter": true,
    "draw_centered": false,
    "menu_visible": false,

    // --- Smooth Behavior ---
    "scroll_past_end": true,
    "word_wrap": "auto",
    "highlight_line": true,
    "animation_enabled": false,
    "caret_style": "blink",
    "color_scheme": "Mariana.sublime-color-scheme",

    //"ignored_packages": [], // Enables vintage mode
    "vintage_start_in_command_mode": true,
    "theme": "Adaptive.sublime-theme",
}
